<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="14.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <SonetaPackageVersion>2604.1.1</SonetaPackageVersion>
    <SonetaTargetFramework>net8.0</SonetaTargetFramework>
    <SonetaTestsTargetFramework>net8.0</SonetaTestsTargetFramework>
    <GenerateAssemblyInformationalVersionAttribute>false</GenerateAssemblyInformationalVersionAttribute>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
    <AggregateOutput>true</AggregateOutput>
  </PropertyGroup>
  <PropertyGroup>
    <Version>2604.1.1</Version>
    <Copyright>Copyright (C) Soneta sp z o.o.</Copyright>
    <Description>Składnik programu Soneta</Description>
    <Authors>$(Product)</Authors>
    <Company>Soneta</Company>
  </PropertyGroup>
</Project>
